# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local a GitHub.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clave "anon" o "publishable" (la pública, segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave "service_role" o "secret": SOLO servidor, nunca en el navegador
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso ---
ALLOWED_EMAIL=aleix.lozal@gmail.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Europe/Madrid
BRIEF_HOUR=9

# --- Se usarán en fases posteriores ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
ENCRYPTION_KEY=
CRON_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
